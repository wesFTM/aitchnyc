# Signs the session cookie. Use a long random string.
AUTH_SECRET=

# Comma-separated Gmail addresses that become super admins when they sign in.
SUPER_ADMIN_EMAILS=wfulghum@gmail.com,hyunheefulghum@gmail.com

# Local sign-in before Google OAuth exists. Ignored when NODE_ENV=production.
DEV_AUTH=true

# Google OAuth web client.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used for the OAuth redirect. Defaults to the request host.
APP_ORIGIN=http://localhost:3000

# Set to 1 only when the Next.js app is running inside a Cloudflare Worker.
# Local `next dev` uses the remote R2 bucket from wrangler.jsonc (wrangler login)
# and a SQLite file in .data/ for the database until D1 is created.
USE_CLOUDFLARE_BINDINGS=

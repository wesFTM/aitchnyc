{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aitchnyc",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "h-nyc.com/*",
      "zone_name": "h-nyc.com"
    },
    {
      "pattern": "*.h-nyc.com/*",
      "zone_name": "h-nyc.com"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aitchnyc"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aitchnyc",
      "database_id": "f75e8dc6-439f-4528-8245-5f0a2d885fdc",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aitchnyc-media",
      "remote": true
    }
  ]
}

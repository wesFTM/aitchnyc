{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aitchnyc",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  // Photos and video use the remote R2 bucket during `next dev`.
  // D1 stays local until the database is created and database_id is filled in.
  //   npx wrangler d1 create aitchnyc
  //   npx wrangler d1 migrations apply aitchnyc --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aitchnyc",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aitchnyc-media",
      "remote": true
    }
  ]
}

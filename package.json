{
  "name": "wes-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "opennextjs-cloudflare build --skipNextBuild",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "next lint",
    "db:migrate:local": "wrangler d1 migrations apply aitchnyc --local",
    "db:migrate:remote": "wrangler d1 migrations apply aitchnyc --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@radix-ui/react-icons": "^1.3.2",
    "framer-motion": "^12.12.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.510.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/estree": "^1.0.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.17.47",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "tailwindcss": "^4",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "sharp@0.35.5": true,
    "sharp@0.34.4": true,
    "unrs-resolver@1.10.1": true,
    "@tailwindcss/oxide@4.1.11": true,
    "fsevents@2.3.3": true
  }
}
